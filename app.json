{
  "expo": {
    "name": "EPG OG",
    "slug": "epg-og",
    "scheme": "epgog",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14161a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.epgog.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.epgog.app",
      "adaptiveIcon": {
        "backgroundColor": "#101940",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#3ea4f0"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "18997e54-6bba-4d16-8468-48df3e5ac3e2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/18997e54-6bba-4d16-8468-48df3e5ac3e2",
      "fallbackToCacheTimeout": 3000,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
